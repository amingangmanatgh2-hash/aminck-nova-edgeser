#version 300 es
precision highp float;
// Nova Horror Bedrock - Terrain Fragment - Enhanced with distortion, blood lens, fear tint
in vec4 color;
in vec2 uv0;
in vec2 uv1;
in vec3 worldPos;
in float fogFactor;

uniform sampler2D TEXTURE_0;
uniform vec4 FOG_COLOR;
uniform float TOTAL_REAL_WORLD_TIME;
uniform float RAIN_LEVEL;
uniform vec2 FOG_CONTROL;

out vec4 fragColor;

float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main() {
    vec2 uv = uv0;

    // Distortion based on time for fear - subtle warp
    float time = TOTAL_REAL_WORLD_TIME * 0.02;
    float distort = RAIN_LEVEL * 0.002 + sin(time * 2.0) * 0.001;
    uv += vec2(sin(uv.y * 10.0 + time * 3.0), cos(uv.x * 8.0 + time * 2.0)) * distort;
    uv = clamp(uv, 0.001, 0.999);

    vec4 tex = texture(TEXTURE_0, uv) * color;

    // Desaturate for horror - real
    float lum = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
    vec3 desat = mix(tex.rgb, vec3(lum), 0.4 + RAIN_LEVEL * 0.2);

    // Cold tint - enhanced with fear (rain as proxy for fear in Bedrock)
    vec3 coldTint = vec3(0.7, 0.8, 0.95);
    coldTint = mix(coldTint, vec3(0.6, 0.2, 0.2), RAIN_LEVEL * 0.3);
    vec3 lit = desat * coldTint;

    // Torch flicker real - enhanced
    float flicker = 1.0 + sin(TOTAL_REAL_WORLD_TIME * 0.05) * 0.05 + sin(TOTAL_REAL_WORLD_TIME * 0.13) * 0.02;
    float torch = uv1.x * flicker;
    float sky = uv1.y * 0.5;
    lit *= (torch * 1.3 + sky * 0.4 + 0.1);

    // Volumetric fog thick dynamic
    vec3 fogCol = FOG_COLOR.rgb * 0.6;
    fogCol = mix(fogCol, vec3(0.15, 0.02, 0.02), RAIN_LEVEL * 0.5);
    fogCol = mix(fogCol, vec3(0.2, 0.05, 0.05), RAIN_LEVEL * RAIN_LEVEL * 0.4);

    // Dust particles - real noise, used
    float dust = hash(uv * 100.0 + time * 2.0);
    vec3 dustCol = vec3(1.0) * step(0.999, dust) * torch * 0.4;

    vec3 finalCol = mix(lit + dustCol, fogCol, fogFactor * 0.7);

    // Vignette - stronger with rain/fear
    vec2 screenUV = gl_FragCoord.xy / vec2(1920.0, 1080.0);
    float vign = 1.0 - length(screenUV - 0.5) * (0.8 + RAIN_LEVEL * 0.4);
    finalCol *= vign;

    // Blood pulse - enhanced with lens blood
    float pulse = sin(TOTAL_REAL_WORLD_TIME * 0.04) * 0.5 + 0.5;
    finalCol = mix(finalCol, finalCol * vec3(1.5, 0.2, 0.2), pulse * RAIN_LEVEL * 0.15);

    // Blood lens splatter procedural
    float bloodNoise = hash(screenUV * 20.0 + time);
    float bloodSplatter = smoothstep(0.88, 0.97, bloodNoise) * RAIN_LEVEL * 0.5;
    vec3 bloodLens = vec3(0.5, 0.05, 0.05) * bloodSplatter;
    finalCol = mix(finalCol, bloodLens, bloodSplatter * 0.5);
    finalCol += bloodLens * 0.2;

    // Chromatic aberration for fear
    float ca = RAIN_LEVEL * 0.001;
    vec3 colR = texture(TEXTURE_0, uv + vec2(ca, 0)).rgb * color.rgb;
    vec3 colB = texture(TEXTURE_0, uv - vec2(ca, 0)).rgb * color.rgb;
    finalCol.r = mix(finalCol.r, colR.r * coldTint.r, RAIN_LEVEL * 0.3);
    finalCol.b = mix(finalCol.b, colB.b * coldTint.b, RAIN_LEVEL * 0.3);


    // Extra: when rain high (fear proxy), add edge darkness and more blood
    if (RAIN_LEVEL > 0.6) {
        float edgeDark = pow(clamp(length(screenUV - 0.5) * 2.0, 0.0, 1.5), 3.0) * (RAIN_LEVEL - 0.6) * 2.0;
        finalCol -= edgeDark;
        float bloodEdge = smoothstep(0.4, 0.8, length(screenUV - 0.5)) * RAIN_LEVEL * 0.4;
        finalCol = mix(finalCol, vec3(0.4, 0.05, 0.05), bloodEdge);
    }

    fragColor = vec4(finalCol, tex.a);
}
