#version 300 es
precision highp float;
in vec4 color; in vec2 uv;
uniform sampler2D TEXTURE_0;
uniform float TOTAL_REAL_WORLD_TIME;
out vec4 fragColor;
void main(){
 vec4 tex=texture(TEXTURE_0, uv)*color;
 // Horror entity - red eyes glow
 if (tex.r>0.8 && tex.g<0.3) tex.rgb+=vec3(0.3,0.0,0.0)* (sin(TOTAL_REAL_WORLD_TIME*5.0)*0.5+0.5);
 fragColor=tex;
}
